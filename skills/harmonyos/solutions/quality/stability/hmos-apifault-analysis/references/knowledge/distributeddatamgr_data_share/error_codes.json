[
  {
    "code": "15700000",
    "message": "Inner error.",
    "source_file": "docs/.../errorcode-datashare.md + frameworks/js/napi/common/include/datashare_error.h",
    "description": "内部错误。可能原因: 1.内部状态异常; 2.错误地使用接口; 3.权限配置错误; 4.系统错误(空指针/内存不足/数据服务异常重启/I/O错误/IPC异常/JS引擎异常)。处理步骤: 1.排查对象关闭后再使用; 2.排查是否按文档正确使用接口; 3.排查权限配置; 4.尝试重试, 提示用户重启应用/升级应用/升级设备版本"
  },
  {
    "code": "15700010",
    "message": "The DataShareHelper fails to be initialized.",
    "source_file": "docs/.../errorcode-datashare.md + frameworks/js/napi/common/include/datashare_error.h",
    "description": "创建DataShareHelper工具类异常。可能原因: 1.createDataShareHelper入参uri不正确; 2.createDataShareHelper入参context不正确; 3.客户端从后台拉起DataShareExtension未配置后台拉起权限。处理步骤: 1.咨询DataShare服务端提供者获取正确的uri路径; 2.检查context是否为Stage模型context; 3.检查客户端是否有数据的读/写权限(通过bm dump查看DataShareExtension配置中的readPermission/writePermission)"
  },
  {
    "code": "15700011",
    "message": "The URI does not exist.",
