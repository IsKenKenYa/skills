{
  "dnsConfiguration": {
    "customDnsServers": [
      {
        "name": "Google Primary DNS",
        "ip": "8.8.8.8",
        "port": 53,
        "description": "Google公共DNS服务器（主）"
      },
      {
        "name": "Google Secondary DNS",
        "ip": "8.8.4.4",
        "port": 53,
        "description": "Google公共DNS服务器（备）"
      },
      {
        "name": "Cloudflare DNS",
        "ip": "1.1.1.1",
        "port": 53,
        "description": "Cloudflare公共DNS服务器"
      }
    ],
    "staticDnsRules": [
      {
        "host": "api.example.com",
        "port": 443,
        "ipAddresses": ["192.168.1.100", "192.168.1.101"],
        "description": "API服务器静态DNS映射"
      },
      {
        "host": "cdn.example.com",
        "port": 443,
        "ipAddresses": ["192.168.2.100"],
        "description": "CDN服务器静态DNS映射"
      },
      {
        "host": "internal.example.com",
        "port": 8080,
        "ipAddresses": ["192.168.3.100"],
        "description": "内部服务器静态DNS映射"
      }
    ],
    "dnsOverHttps": {
      "enabled": true,
      "servers": [
        {
          "name": "Google DOH",
          "url": "https://dns.google/dns-query",
          "skipCertificatesValidation": false
        },
        {
          "name": "Cloudflare DOH",
          "url": "https://cloudflare-dns.com/dns-query",
          "skipCertificatesValidation": false
        }
      ],
      "defaultServer": "Google DOH"
    },
    "happyEyeball": {
      "enabled": true,
      "description": "启用Happy Eyeball竞速连接，多个IP地址同时生效"
    },
    "timeout": {
      "dnsResolutionMs": 5000,
      "dnsConnectionMs": 3000,
      "description": "DNS解析超时配置"
    }
  },
  "requestConfiguration": {
    "dns": {
      "dnsRules": [
        {
          "ip": "8.8.8.8",
          "port": 53
        }
      ],
      "dnsOverHttps": {
        "url": "https://dns.google/dns-query",
        "skipCertificatesValidation": false
      },
      "happyEyeballOnDnsRule": true
    }
  },
  "sessionConfiguration": {
    "requestConfiguration": {
      "dns": {
        "dnsRules": [
          {
            "ip": "8.8.8.8",
            "port": 53
          },
          {
            "ip": "8.8.4.4",
            "port": 53
          }
        ]
      }
    }
  },
  "testCases": {
    "customDnsServer": {
      "testUrl": "https://example.com",
      "expectedStatusCode": 200,
      "timeout": 10000
    },
    "staticDnsRule": {
      "testHost": "api.example.com",
      "testPort": 443,
      "expectedIpAddresses": ["192.168.1.100", "192.168.1.101"]
    },
    "dynamicDnsRule": {
      "testHost": "custom.example.com",
      "testPort": 443,
      "expectedIpAddresses": ["192.168.100.1"]
    },
    "dnsOverHttps": {
      "testUrl": "https://dns.google/dns-query",
      "expectedResponse": "DNS query successful"
    }
  }
}