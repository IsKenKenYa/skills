{
  "sessionConfiguration": {
    "requestConfiguration": {
      "transfer": {
        "autoRedirect": true,
        "timeout": {
          "connectMs": 6000,
          "transferMs": 60000,
          "inactivityMs": 6000
        },
        "assumesHTTP3Capable": false,
        "maxAutoRedirects": 50
      },
      "tracing": {
        "verbose": false,
        "collectTimeInfo": false
      },
      "proxy": "system",
      "security": {
        "remoteValidation": "skip",
        "tlsOptions": {
          "tlsVersion": "TlsV1.3"
        }
      }
    },
    "connectionConfiguration": {
      "maxConnectionsPerHost": 6,
      "maxTotalConnections": 64
    }
  }
}