// module.json5配置示例
// 文件路径: entry/src/main/module.json5

{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "LockScreenFormAbility",
        "srcEntry": "./ets/formability/LockScreenFormAbility.ets",
        "type": "form",
        "label": "$string:LockScreenFormAbility_label",
        "description": "$string:LockScreenFormAbility_desc",
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:lockscreen_form_config"
          }
        ],
        "exported": true
      }
    ]
  }
}

// 注意事项:
// 1. extensionAbilities中必须配置FormExtensionAbility
// 2. metadata中name必须为"ohos.extension.form"(固定值)
// 3. resource指向form_config.json文件路径
// 4. exported设置为true表示可以被其他应用调用
// 5. deviceTypes包含"phone"和"tablet"(锁屏卡片仅支持手机和平板)