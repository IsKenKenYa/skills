                "maxFileSupported": 50
              },
              {
                "scheme": "file",
                "utd": "general.png",
                "maxFileSupported": 50
              },
              {
                "scheme": "file",
                "utd": "general.jpeg",
                "maxFileSupported": 50
              },
              {
                "scheme": "file",
                "utd": "general.video",
                "maxFileSupported": 10
              },
              {
                "scheme": "file",
                "utd": "general.audio",
                "maxFileSupported": 10
              },
              {
                "scheme": "file",
                "utd": "general.file",
                "maxFileSupported": 10
              }
            ]
          }
        ]
      }
    ]
