{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "$string:permission_reason_network",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ]
  },
  "app": {
    "bundleName": "com.example.shippingaddress",
    "vendor": "example",
    "versionCode": 1000000,
    "versionName": "1.0.0",
    "icon": "$media:app_icon",
    "label": "$string:app_name",
    "description": "$string:app_desc",
    "minAPIVersion": 50000012,
    "targetAPIVersion": 50000012,
    "apiReleaseType": "Release",
    "debug": false,
    "compileMode": "ets",
    "compileType": "esnext",
    
    // 关键配置：Client ID
    // 注意：需要在AGC中获取应用的Client ID并配置此处
    // 详见：https://developer.huawei.com/consumer/cn/doc/harmonyos-guides/account-client-id
    "clientId": "YOUR_CLIENT_ID_HERE",
    
    // 关键配置：分布式配置
    "distributedNotificationEnabled": true
  }
}

/**
 * 配置说明：
 * 
 * 1. deviceTypes：支持的设备类型
 *    - phone: 手机
 *    - tablet: 平板
 *    - 2in1: PC/2in1设备
 *    注意：获取收货地址功能支持Phone/Tablet/PC/2in1设备
 *    API 26.0.0版本起还支持TV、Car设备
 * 
 * 2. minAPIVersion：最低API版本
 *    - 50000012对应API 5.0.0(12)
 *    - 获取收货地址API从5.0.0(12)版本开始支持
 * 
 * 3. clientId：应用Client ID（关键配置）
 *    - 必须配置正确的Client ID，否则返回1008100004错误码
 *    - Client ID从AGC应用详情中获取
 *    - 配置指南：https://developer.huawei.com/consumer/cn/doc/harmonyos-guides/account-client-id
 * 
 * 4. requestPermissions：权限申请
 *    - ohos.permission.GET_NETWORK_INFO：获取网络信息权限（用于网络状态检测）
 *    - 获取收货地址不需要额外权限声明，权限在AGC中申请
 * 
 * 5. 应用指纹证书配置（关键）
 *    - 需在AGC中添加应用的公钥指纹证书
 *    - 配置指南：https://developer.huawei.com/consumer/cn/doc/harmonyos-guides/account-sign-fingerprints
 *    - 未配置或配置错误将返回1008100004错误码
 * 
 * 6. 企业开发者权限申请（关键）
 *    - 需在AGC中申请"获取收货地址"权限
 *    - 仅企业开发者可申请
 *    - 申请指南：https://developer.huawei.com/consumer/cn/doc/harmonyos-guides/account-config-permissions
 *    - 未申请将返回1008100005错误码
 */