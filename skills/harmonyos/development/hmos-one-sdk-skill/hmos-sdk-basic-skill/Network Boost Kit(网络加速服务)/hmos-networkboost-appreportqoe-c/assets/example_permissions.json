{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "Network Boost Kit应用传输体验反馈示例",
    "deviceTypes": [
      "default",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationWithFree": false,
    "page": "pages/MainPage",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ts",
        "description": "Main ability of the application",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "launchType": "multiton",
        "visible": true,
        "skills": [
          {
            "actions": [
              "action.system.home"
            ],
            "entities": [
              "entity.system.home"
            ]
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "用于获取设备网络信息并上报传输体验质量",
        "usedScene": {
          "ability": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.INTERNET",
        "reason": "允许应用访问网络",
        "usedScene": {
          "ability": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ]
  }
}