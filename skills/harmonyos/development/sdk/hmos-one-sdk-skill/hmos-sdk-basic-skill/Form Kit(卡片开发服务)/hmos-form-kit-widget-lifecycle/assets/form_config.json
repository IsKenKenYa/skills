{
  "forms": [
    {
      "name": "Widget",
      "displayName": "天气卡片",
      "description": "显示天气信息的卡片",
      "src": "./ets/widget/pages/WidgetCard.ets",
      "uiSyntax": "arkts",
      "window": {
        "designWidth": 720,
        "autoDesignWidth": true
      },
      "colorMode": "auto",
      "isDefault": true,
      "updateEnabled": true,
      "scheduledUpdateTime": "10:30",
      "updateDuration": 1,
      "defaultDimension": "2*2",
      "supportDimensions": [
        "2*2",
        "2*4",
        "4*4"
      ],
      "formConfigAbility": "ability://com.example.myapplication.EntryFormAbility",
      "metadata": {
        "customizeData": [
          {
            "name": "originWidgetName",
            "value": "com.example.myapplication.Widget"
          }
        ]
      }
    },
    {
      "name": "ClockWidget",
      "displayName": "时钟卡片",
      "description": "显示时间和日期的卡片",
      "src": "./ets/widget/pages/ClockWidgetCard.ets",
      "uiSyntax": "arkts",
      "window": {
        "designWidth": 720,
        "autoDesignWidth": true
      },
      "colorMode": "auto",
      "isDefault": false,
      "updateEnabled": true,
      "scheduledUpdateTime": "00:00",
      "updateDuration": 0,
      "defaultDimension": "2*2",
      "supportDimensions": [
        "1*2",
        "2*2",
        "2*4"
      ],
      "formConfigAbility": "ability://com.example.myapplication.EntryFormAbility"
    }
  ]
}